#######################
#                     #
#        Site         #
#                     #
#######################

NUXT_SITE_URL=http://localhost:3000

#######################
#                     #
#      Database       #
#                     #
#######################

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hydcraft_portal?schema=public

#######################
#                     #
#        Auth         #
#                     #
#######################

JWT_SECRET=change-me
JWT_EXPIRES_IN_SECONDS=900
REFRESH_TOKEN_EXPIRES_IN_SECONDS=2592000
CONFIG_ENCRYPTION_KEY=change-me-with-a-long-random-secret
DEFAULT_OWNER_PASSWORD=

#######################
#                     #
#        Mail         #
#                     #
#######################

# Mail runtime. Leave MAIL_ENABLED=false locally if you do not want SMTP calls.
MAIL_ENABLED=false
MAIL_FROM="HydCraft <no-reply@example.com>"
MAIL_REPLY_TO=
MAIL_SMTP_HOST=smtp.example.com
MAIL_SMTP_PORT=465
MAIL_SMTP_SECURE=true
MAIL_SMTP_USER=no-reply@example.com
MAIL_SMTP_PASSWORD=change-me

#######################
#                     #
#        OAuth        #
#                     #
#######################

# Optional Cloudflare Worker proxy for OAuth token/userinfo requests.
# Compatible with Hydroline oauth-proxy: https://github.com/Hydroline/oauth-proxy
OAUTH_PROXY_URL=
OAUTH_PROXY_KEY=

GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/oauth/github/callback
GITHUB_OAUTH_PROXY_ENABLED=false

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/oauth/google/callback
GOOGLE_OAUTH_PROXY_ENABLED=false

MICROSOFT_OAUTH_TENANT_ID=common
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/oauth/microsoft/callback

QQ_OAUTH_CLIENT_ID=
QQ_OAUTH_CLIENT_SECRET=
QQ_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/oauth/qq/callback

#######################
#                     #
#       Storage       #
#                     #
#######################

# Tencent Cloud COS credentials. SecretId usually starts with AKID.
COS_SECRET_ID=
COS_SECRET_KEY=
COS_REGION=ap-guangzhou

# Single shared attachment bucket. Tencent COS bucket names usually include the APPID suffix.
COS_ATTACHMENTS_BUCKET=hydcraft-attachments-1250000000

# Public CDN / EdgeOne origin-facing URL for public attachment objects.
# Use https:// and do not add a trailing slash.
COS_PUBLIC_BASE_URL=https://static.example.com
