model ExternalSyncTaskState {
  id              String             @id @default(cuid())
  taskKey         String             @unique
  serverId        String
  server          MinecraftServer    @relation(fields: [serverId], references: [serverId], onDelete: Cascade, onUpdate: Cascade)
  source          ExternalSyncSource
  reason          ExternalSyncReason?
  running         Boolean            @default(false)
  intervalSeconds Int                @default(1800)
  lastStartedAt   DateTime?
  lastFinishedAt  DateTime?
  lastSuccessAt   DateTime?
  lastError        String?
  rowsRead        Int                @default(0)
  rowsMatched     Int                @default(0)
  rowsChanged     Int                @default(0)
  rowsSkipped     Int                @default(0)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([serverId])
  @@index([source])
  @@index([running])
  @@index([lastSuccessAt])
}

model MinecraftServerLuckPermsGroup {
  id        String   @id @default(cuid())
  serverId  String
  server    MinecraftServer @relation(fields: [serverId], references: [serverId], onDelete: Cascade, onUpdate: Cascade)
  name      String
  raw       Json?
  rawHash   String?
  syncedAt  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([serverId, name])
  @@index([serverId])
  @@index([name])
}
