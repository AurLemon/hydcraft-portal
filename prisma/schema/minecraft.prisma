model MinecraftAccount {
  id                 String                 @id @default(cuid())
  userId             String?
  user               User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  username           String
  normalizedUsername String                 @unique
  uuid               String?                @unique
  status             MinecraftAccountStatus @default(PENDING)
  source             MinecraftAccountSource @default(PORTAL)
  authmeName         String?
  authmeId           Int?                   @unique
  firstJoinedAt      DateTime?
  lastSeenAt         DateTime?
  isPrimary          Boolean                @default(false)
  verifiedAt         DateTime?
  unlinkedAt         DateTime?
  note               String?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  @@index([userId])
  @@index([username])
  @@index([authmeName])
  @@index([status])
  @@index([source])
}

model MinecraftServer {
  id          String   @id @default(cuid())
  serverId    String   @unique
  code        String   @unique
  name        String
  description String?
  host        String
  port        Int      @default(25565)
  enabled     Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  portalBridge PortalBridgeConfig?
  authMe       AuthMeSourceConfig?
  luckPerms    LuckPermsSourceConfig?
  snapshots    MinecraftServerSnapshot[]
  identities   ServerPlayerIdentity[]
  sessions     ServerPlayerSession[]
}

model PortalBridgeConfig {
  id                  String                      @id @default(cuid())
  minecraftServerId   String                      @unique
  minecraftServer     MinecraftServer             @relation(fields: [minecraftServerId], references: [id], onDelete: Cascade)
  bridgeId            String
  module              String                      @default("portalbridge-core")
  wsUrl               String
  encryptedSecret     String?
  enabled             Boolean                     @default(false)
  requestedTopics     String[]                    @default([])
  allowedTopics       String[]                    @default([])
  resumeFromSeq       BigInt                      @default(0)
  lastConnectionState PortalBridgeConnectionState @default(DISCONNECTED)
  lastConnectedAt     DateTime?
  lastDisconnectedAt  DateTime?
  lastError           String?
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt

  receipts PortalBridgeMessageReceipt[]
  commands PortalBridgeCommand[]

  @@unique([bridgeId, module])
  @@index([enabled])
  @@index([lastConnectionState])
}

model AuthMeSourceConfig {
  id                String          @id @default(cuid())
  minecraftServerId String          @unique
  minecraftServer   MinecraftServer @relation(fields: [minecraftServerId], references: [id], onDelete: Cascade)
  host              String
  port              Int             @default(3306)
  database          String
  username          String
  encryptedPassword String?
  enabled           Boolean         @default(false)
  lastSyncAt        DateTime?
  lastError         String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([enabled])
}

model LuckPermsSourceConfig {
  id                String          @id @default(cuid())
  minecraftServerId String          @unique
  minecraftServer   MinecraftServer @relation(fields: [minecraftServerId], references: [id], onDelete: Cascade)
  host              String
  port              Int             @default(3306)
  database          String
  username          String
  encryptedPassword String?
  enabled           Boolean         @default(false)
  lastSyncAt        DateTime?
  lastError         String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([enabled])
}

model MinecraftServerSnapshot {
  id         String                      @id @default(cuid())
  serverId   String
  server     MinecraftServer             @relation(fields: [serverId], references: [serverId], onDelete: Cascade)
  kind       MinecraftServerSnapshotKind
  observedAt DateTime
  payload    Json
  createdAt  DateTime                    @default(now())

  @@index([serverId])
  @@index([kind])
  @@index([observedAt])
}

model ServerPlayerIdentity {
  id                 String                            @id @default(cuid())
  serverId           String
  server             MinecraftServer                   @relation(fields: [serverId], references: [serverId], onDelete: Cascade)
  uuid               String
  username           String?
  normalizedUsername String?
  uuidSource         String?
  firstSeenAt        DateTime?
  lastSeenAt         DateTime?
  evidenceCount      Int                               @default(0)
  conflictState      ServerPlayerIdentityConflictState @default(NONE)
  createdAt          DateTime                          @default(now())
  updatedAt          DateTime                          @updatedAt

  @@unique([serverId, uuid])
  @@index([normalizedUsername])
  @@index([conflictState])
}

model ServerPlayerIdentityEvidence {
  id                 String                             @id @default(cuid())
  source             ServerPlayerIdentityEvidenceSource
  sourceMessageId    String?
  serverId           String
  uuid               String?
  username           String?
  normalizedUsername String?
  uuidSource         String?
  observedAt         DateTime
  payload            Json?
  createdAt          DateTime                           @default(now())

  @@unique([source, sourceMessageId])
  @@index([serverId, uuid])
  @@index([normalizedUsername])
  @@index([observedAt])
}

model ServerPlayerSession {
  id                 String          @id @default(cuid())
  serverId           String
  server             MinecraftServer @relation(fields: [serverId], references: [serverId], onDelete: Cascade)
  sessionId          String?
  uuid               String
  username           String?
  normalizedUsername String?
  openedAt           DateTime
  closedAt           DateTime?
  closeReason        String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@unique([serverId, sessionId])
  @@index([serverId, uuid])
  @@index([openedAt])
  @@index([closedAt])
}

model PortalBridgeMessageReceipt {
  id             String             @id @default(cuid())
  bridgeConfigId String
  bridgeConfig   PortalBridgeConfig @relation(fields: [bridgeConfigId], references: [id], onDelete: Cascade)
  messageId      String
  seq            BigInt?
  topic          String
  receivedAt     DateTime           @default(now())
  ackedAt        DateTime?
  payload        Json?

  @@unique([messageId])
  @@unique([bridgeConfigId, seq])
  @@index([topic])
  @@index([receivedAt])
}

model PortalBridgeCommand {
  id             String                    @id @default(cuid())
  bridgeConfigId String
  bridgeConfig   PortalBridgeConfig        @relation(fields: [bridgeConfigId], references: [id], onDelete: Cascade)
  commandId      String                    @unique
  action         String
  status         PortalBridgeCommandStatus @default(PENDING)
  payload        Json?
  sentAt         DateTime?
  completedAt    DateTime?
  errorMessage   String?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  @@index([bridgeConfigId])
  @@index([action])
  @@index([status])
}
