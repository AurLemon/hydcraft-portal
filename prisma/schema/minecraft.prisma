model MinecraftAccount {
  id                 String                 @id @default(cuid())
  userId             String?
  user               User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  username           String
  normalizedUsername String                 @unique
  uuid               String?                @unique
  status             MinecraftAccountStatus @default(PENDING)
  source             MinecraftAccountSource @default(PORTAL)
  identityKind       MinecraftAccountIdentityKind @default(AUTHENTICATED)
  assignmentMode     MinecraftAccountAssignmentMode @default(IMPORTED_UNASSIGNED)
  authmeName         String?
  authmeId           Int?                   @unique
  firstJoinedAt      DateTime?
  lastSeenAt         DateTime?
  isPrimary          Boolean                @default(false)
  verifiedAt         DateTime?
  unlinkedAt         DateTime?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  authMeAccount AuthMeAccount? @relation(fields: [authmeId], references: [authmeId], onDelete: SetNull, onUpdate: Cascade)
  bindingHistory MinecraftAccountBindingHistory[]
  registrationTickets AuthRegistrationTicket[]

  @@index([userId])
  @@index([username])
  @@index([authmeName])
  @@index([status])
  @@index([source])
  @@index([identityKind])
  @@index([assignmentMode])
}

model MinecraftAccountBindingHistory {
  id                 String                       @id @default(cuid())
  minecraftAccountId String
  minecraftAccount   MinecraftAccount             @relation(fields: [minecraftAccountId], references: [id], onDelete: Cascade)
  action             MinecraftAccountBindingAction
  actorUserId        String?
  targetUserId       String?
  previousUserId     String?
  reason             String?
  metadata           Json?
  createdAt          DateTime                     @default(now())

  @@index([minecraftAccountId, createdAt])
  @@index([targetUserId, createdAt])
  @@index([action, createdAt])
}

model MinecraftServer {
  id             String                        @id @default(cuid())
  serverId       String                        @unique
  code           String                        @unique
  shortCode      String
  nameZhCn       String
  nameZhTw       String
  nameEnUs       String
  nameJaJp       String
  host           String
  port           Int                           @default(25565)
  enabled        Boolean                       @default(true)
  kind           MinecraftServerKind           @default(MAIN)
  status         MinecraftServerStatus         @default(LIVE)
  dataSourceMode MinecraftServerDataSourceMode @default(PORTAL_BRIDGE)
  isDefault      Boolean                       @default(false)
  sortOrder      Int                           @default(0)
  createdAt      DateTime                      @default(now())
  updatedAt      DateTime                      @updatedAt

  portalBridge PortalBridgeConfig?
  snapshots    MinecraftServerSnapshot[]
  identities   ServerPlayerIdentity[]
  sessions     ServerPlayerSession[]
  players      MinecraftServerPlayer[]
  partnerEntries PartnerEntry[]
  externalSyncTaskStates ExternalSyncTaskState[]
  periods      MinecraftServerPeriod[]
  mapConfig    MinecraftServerMapConfig?
  archiveImportRuns ArchiveImportRun[]
}

model MinecraftServerPeriod {
  id                String                    @id @default(cuid())
  minecraftServerId String
  minecraftServer   MinecraftServer           @relation(fields: [minecraftServerId], references: [id], onDelete: Cascade)
  kind              MinecraftServerPeriodKind @default(LIVE)
  startedAt         DateTime
  endedAt           DateTime?
  note              String?
  sortOrder         Int                       @default(0)
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  @@index([minecraftServerId, sortOrder])
  @@index([startedAt])
  @@index([endedAt])
}

model MinecraftServerMapConfig {
  id                String          @id @default(cuid())
  minecraftServerId String          @unique
  minecraftServer   MinecraftServer @relation(fields: [minecraftServerId], references: [id], onDelete: Cascade)
  enabled           Boolean         @default(false)
  hasTiles          Boolean         @default(false)
  tileBaseUrl       String?
  worldName         String          @default("world")
  mapName           String          @default("flat")
  tileExtension     String          @default("jpg")
  defaultCenterX    Float           @default(811)
  defaultCenterZ    Float           @default(2933)
  defaultZoom       Int             @default(0)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

model ArchiveImportRun {
  id                     String                @id @default(cuid())
  minecraftServerId      String
  minecraftServer        MinecraftServer       @relation(fields: [minecraftServerId], references: [id], onDelete: Cascade)
  status                 ArchiveImportRunStatus @default(RUNNING)
  artifactPath           String
  artifactHash           String?
  artifactServerId       String?
  artifactServerName     String?
  artifactVersion        String?
  scannedAt              DateTime?
  importedAt             DateTime?
  playersObserved        Int                   @default(0)
  playersUpdated         Int                   @default(0)
  accountsMatched        Int                   @default(0)
  historicalAccountsCreated Int                @default(0)
  errorMessage           String?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  @@index([minecraftServerId, createdAt])
  @@index([status, createdAt])
}

model PortalBridgeConfig {
  id                  String                      @id @default(cuid())
  minecraftServerId   String                      @unique
  minecraftServer     MinecraftServer             @relation(fields: [minecraftServerId], references: [id], onDelete: Cascade)
  bridgeId            String
  module              String                      @default("portalbridge-core")
  wsUrl               String
  encryptedSecret     String?
  enabled             Boolean                     @default(false)
  requestedTopics     String[]                    @default([])
  allowedTopics       String[]                    @default([])
  coreSyncIntervalMinutes Int                     @default(30)
  streamEpoch         String?
  resumeFromSeq       BigInt                      @default(0)
  lastConnectionState PortalBridgeConnectionState @default(DISCONNECTED)
  lastConnectedAt     DateTime?
  lastDisconnectedAt  DateTime?
  lastError           String?
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt

  receipts PortalBridgeMessageReceipt[]
  commands PortalBridgeCommand[]

  @@unique([bridgeId, module])
  @@index([enabled])
  @@index([lastConnectionState])
}

model MinecraftServerSnapshot {
  id         String                      @id @default(cuid())
  serverId   String
  server     MinecraftServer             @relation(fields: [serverId], references: [serverId], onDelete: Cascade, onUpdate: Cascade)
  kind       MinecraftServerSnapshotKind
  observedAt DateTime
  payload    Json
  createdAt  DateTime                    @default(now())

  @@index([serverId])
  @@index([kind])
  @@index([observedAt])
}

model ServerPlayerIdentity {
  id                 String                            @id @default(cuid())
  serverId           String
  server             MinecraftServer                   @relation(fields: [serverId], references: [serverId], onDelete: Cascade, onUpdate: Cascade)
  uuid               String
  username           String?
  normalizedUsername String?
  uuidSource         String?
  firstSeenAt        DateTime?
  lastSeenAt         DateTime?
  evidenceCount      Int                               @default(0)
  conflictState      ServerPlayerIdentityConflictState @default(NONE)
  createdAt          DateTime                          @default(now())
  updatedAt          DateTime                          @updatedAt

  @@unique([serverId, uuid])
  @@index([normalizedUsername])
  @@index([conflictState])
}

model ServerPlayerIdentityEvidence {
  id                 String                             @id @default(cuid())
  source             ServerPlayerIdentityEvidenceSource
  sourceMessageId    String?
  evidenceHash       String?
  serverId           String
  uuid               String?
  username           String?
  normalizedUsername String?
  uuidSource         String?
  observedAt         DateTime
  payload            Json?
  createdAt          DateTime                           @default(now())

  @@unique([source, sourceMessageId])
  @@unique([source, serverId, uuid, evidenceHash])
  @@index([serverId, uuid])
  @@index([normalizedUsername])
  @@index([observedAt])
}

model ServerPlayerSession {
  id                 String          @id @default(cuid())
  serverId           String
  server             MinecraftServer @relation(fields: [serverId], references: [serverId], onDelete: Cascade, onUpdate: Cascade)
  sessionId          String?
  uuid               String
  username           String?
  normalizedUsername String?
  openedAt           DateTime
  closedAt           DateTime?
  closeReason        String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@unique([serverId, sessionId])
  @@index([serverId, uuid])
  @@index([openedAt])
  @@index([closedAt])
}

model MinecraftServerPlayer {
  id                        String                            @id @default(cuid())
  serverId                  String
  server                    MinecraftServer                   @relation(fields: [serverId], references: [serverId], onDelete: Cascade, onUpdate: Cascade)
  uuid                      String
  username                  String?
  normalizedUsername        String?
  uuidSource                String?
  firstSeenAt               DateTime?
  lastSeenAt                DateTime?
  evidenceCount             Int                               @default(0)
  conflictState             ServerPlayerIdentityConflictState @default(NONE)
  portalAccountId           String?
  portalUserId              String?
  portalAccountStatus       MinecraftAccountStatus?
  portalAccountSource       MinecraftAccountSource?
  online                    Boolean                           @default(false)
  lastOnlineAt              DateTime?
  lastOfflineAt             DateTime?
  lastOnlineWorldName       String?
  lastOnlineDimension       String?
  lastOnlineX               Float?
  lastOnlineY               Float?
  lastOnlineZ               Float?
  bridgeSyncedAt            DateTime?
  createdAt                 DateTime                          @default(now())
  updatedAt                 DateTime                          @updatedAt

  playerData                MinecraftServerPlayerData?
  statsSnapshot             MinecraftServerPlayerStatsSnapshot?
  advancementsSnapshot      MinecraftServerPlayerAdvancementsSnapshot?
  advancementUnlockEvents   PlayerAdvancementUnlockEvent[]

  @@unique([serverId, uuid])
  @@index([serverId])
  @@index([serverId, normalizedUsername])
  @@index([serverId, lastSeenAt])
}

model MinecraftServerPlayerData {
  id                      String                @id @default(cuid())
  minecraftServerPlayerId String                @unique
  player                  MinecraftServerPlayer @relation(fields: [minecraftServerPlayerId], references: [id], onDelete: Cascade)
  playerDataFile          String?
  lastModifiedAt          DateTime?
  hasStatsFile            Boolean               @default(false)
  hasAdvancementsFile     Boolean               @default(false)
  lastKnownName           String?
  firstPlayedAt           DateTime?
  lastPlayedAt            DateTime?
  lastWorldName           String?
  lastDimension           String?
  lastX                   Float?
  lastY                   Float?
  lastZ                   Float?
  lastYaw                 Float?
  lastPitch               Float?
  syncedAt                DateTime              @default(now())
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
}

model MinecraftServerPlayerStatsSnapshot {
  id                      String                @id @default(cuid())
  minecraftServerPlayerId String                @unique
  player                  MinecraftServerPlayer @relation(fields: [minecraftServerPlayerId], references: [id], onDelete: Cascade)
  snapshotId              String
  statsHash               String?
  observedAt              DateTime
  lastScannedAt           DateTime?
  stats                   Json
  createdAt               DateTime              @default(now())

  @@index([snapshotId])
  @@index([observedAt])
}

model MinecraftServerPlayerAdvancementsSnapshot {
  id                      String                @id @default(cuid())
  minecraftServerPlayerId String                @unique
  player                  MinecraftServerPlayer @relation(fields: [minecraftServerPlayerId], references: [id], onDelete: Cascade)
  snapshotId              String
  advancementsHash        String?
  observedAt              DateTime
  lastScannedAt           DateTime?
  advancements            Json
  createdAt               DateTime              @default(now())

  @@index([snapshotId])
  @@index([observedAt])
}

/// 玩家成就解锁事件。advancements 快照覆盖式写入会丢失历史，
/// 故在每次快照同步时做差分：对比新旧快照，对「本次新变为 done」的成就落一条事件，
/// 用于公开主页「最近活动」卡片展示「最近解锁的成就」。
model PlayerAdvancementUnlockEvent {
  id                      String                @id @default(cuid())
  minecraftServerPlayerId String
  player                  MinecraftServerPlayer @relation(fields: [minecraftServerPlayerId], references: [id], onDelete: Cascade)
  serverId                String
  uuid                    String
  advancementKey          String
  /// 触发该事件的快照 observedAt，近似为解锁时间。
  unlockedAt              DateTime
  observedAt              DateTime
  createdAt               DateTime              @default(now())

  @@unique([minecraftServerPlayerId, advancementKey])
  @@index([minecraftServerPlayerId, unlockedAt])
  @@index([uuid, unlockedAt])
}

model PortalBridgeMessageReceipt {
  id             String             @id @default(cuid())
  bridgeConfigId String
  bridgeConfig   PortalBridgeConfig @relation(fields: [bridgeConfigId], references: [id], onDelete: Cascade)
  messageId      String
  streamEpoch    String?
  seq            BigInt?
  topic          String
  receivedAt     DateTime           @default(now())
  ackedAt        DateTime?
  payload        Json?

  @@unique([messageId])
  @@unique([bridgeConfigId, streamEpoch, seq])
  @@index([topic])
  @@index([receivedAt])
}

model PortalBridgeCommand {
  id             String                    @id @default(cuid())
  bridgeConfigId String
  bridgeConfig   PortalBridgeConfig        @relation(fields: [bridgeConfigId], references: [id], onDelete: Cascade)
  commandId      String                    @unique
  action         String
  status         PortalBridgeCommandStatus @default(PENDING)
  payload        Json?
  sentAt         DateTime?
  completedAt    DateTime?
  errorMessage   String?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  @@index([bridgeConfigId])
  @@index([action])
  @@index([status])
}
