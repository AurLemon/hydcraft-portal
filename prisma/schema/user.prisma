model User {
  id                 String     @id @default(cuid())
  handle             String     @unique
  username           String     @unique
  usernameChangedAt  DateTime?
  hydrolineId        String     @unique
  displayName        String?
  email              String?    @unique
  emailVerifiedAt    DateTime?
  avatarUrl          String?
  coverUrl           String?
  avatarAttachmentId String?
  coverAttachmentId  String?
  bio                String?
  schoolOrCompany    String?
  occupationOrMajor  String?
  location           String?
  countryOrRegion    String?
  gender             UserGender @default(UNSPECIFIED)
  birthday           DateTime?
  role               UserRole   @default(USER)
  status             UserStatus @default(ACTIVE)
  statusReason       String?
  verified           Boolean    @default(false)
  verifiedTextZhCn   String?
  verifiedTextZhTw   String?
  verifiedTextEnUs   String?
  verifiedTextJaJp   String?
  lastLoginAt        DateTime?
  lastAuthActivityAt DateTime?
  lastAuthActivitySource UserAuthActivitySource?
  joinedAt           DateTime   @default(now())
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  minecraftAccounts  MinecraftAccount[]
  externalAccounts   ExternalAccount[]
  emails             UserEmail[]
  credential         UserCredential?
  refreshTokens      RefreshToken[]
  emailTokens        EmailVerificationToken[]
  oauthStateTokens   OAuthStateToken[]
  securityEvents     SecurityEvent[]
  profile            UserProfile?
  preferences        UserProfilePreferences?
  privacy            UserProfilePrivacy?
  badges             UserProfileBadge[]
  activityEvents     UserActivityEvent[]
  createdAttachments Attachment[]            @relation("AttachmentCreatedBy")
  partnerEditorAssignments PartnerEditor[]   @relation("PartnerEditorUser")
  createdPartnerEditorAssignments PartnerEditor[] @relation("PartnerEditorCreatedBy")
  partnerCoreMemberAssignments PartnerCoreMember[] @relation("PartnerCoreMemberUser")
  createdPartnerCoreMemberAssignments PartnerCoreMember[] @relation("PartnerCoreMemberCreatedBy")
  friendLinkApplications FriendLinkApplication[] @relation("FriendLinkApplicant")
  reviewedFriendLinkApplications FriendLinkApplication[] @relation("FriendLinkReviewer")

  @@index([lastAuthActivityAt])
}

model UserActivityEvent {
  id         String                @id @default(cuid())
  userId     String
  user       User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       UserActivityEventType
  detail     String?
  serverName String?
  occurredAt DateTime              @default(now())
  createdAt  DateTime              @default(now())

  @@index([userId, occurredAt])
  @@index([type, occurredAt])
  @@unique([userId, type, occurredAt])
}

model UserProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  h2wikiPageName String?
  githubUsername String?
  websiteUrl     String?
  bilibiliUrl    String?
  qqNumber       String?
  wechatId       String?
  publicEmail    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model UserProfilePreferences {
  id           String              @id @default(cuid())
  userId       String              @unique
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  language     UserProfileLanguage @default(ZH_CN)
  timezoneMode TimezoneMode        @default(AUTO)
  timezone     String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
}

model UserProfilePrivacy {
  id                             String   @id @default(cuid())
  userId                         String   @unique
  user                           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  publicProfile                  Boolean  @default(true)
  showHydrolineId                Boolean  @default(true)
  showJoinedAt                   Boolean  @default(true)
  showLocation                   Boolean  @default(true)
  showCountryOrRegion            Boolean  @default(true)
  showBirthday                   Boolean  @default(true)
  showBadges                     Boolean  @default(true)
  showBio                        Boolean  @default(true)
  showMinecraftProfileLink       Boolean  @default(true)
  showSocialLinks                Boolean  @default(true)
  showActivityStatus             Boolean  @default(true)
  searchableInUserDirectory      Boolean  @default(true)
  allowMinecraftProfileDiscovery Boolean  @default(true)
  createdAt                      DateTime @default(now())
  updatedAt                      DateTime @updatedAt
}

model UserProfileBadge {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeId   String?
  badge     ProfileBadge? @relation(fields: [badgeId], references: [id], onDelete: SetNull)
  label     String?
  color     String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([badgeId])
  @@index([userId, sortOrder])
  @@unique([userId, badgeId])
}

model ProfileBadge {
  id          String   @id @default(cuid())
  key         String   @unique
  labelZhCn   String
  labelZhTw   String
  labelEnUs   String
  labelJaJp   String
  color       String
  icon        String?
  description String?
  enabled     Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assignments UserProfileBadge[]

  @@index([enabled, sortOrder])
}

model UserCredential {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
}

model ExternalAccount {
  id                String           @id @default(cuid())
  userId            String
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          ExternalProvider
  providerAccountId String
  providerUsername  String?
  providerEmail     String?
  avatarAttachmentId String?
  avatarUrl         String?
  scope             String?
  rawProfile        Json?
  connectedAt       DateTime         @default(now())
  lastUsedAt        DateTime?
  disconnectedAt    DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@index([userId, provider])
  @@index([disconnectedAt])
}

model UserEmail {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  email          String        @unique
  kind           UserEmailKind
  verifiedAt     DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([userId])
  @@index([userId, kind])
}

model EmailVerificationToken {
  id           String                   @id @default(cuid())
  userId       String
  user         User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  email        String
  codeHash     String
  purpose      EmailVerificationPurpose
  locale       UserProfileLanguage      @default(ZH_CN)
  expiresAt    DateTime
  consumedAt   DateTime?
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  @@index([userId, email, purpose])
  @@index([expiresAt])
  @@index([consumedAt])
}

model AuthEmailCode {
  id         String               @id @default(cuid())
  email      String
  codeHash   String
  purpose    AuthEmailCodePurpose
  locale     UserProfileLanguage  @default(ZH_CN)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  @@index([email, purpose])
  @@index([expiresAt])
  @@index([consumedAt])
}

model OAuthStateToken {
  id          String           @id @default(cuid())
  userId      String?
  user        User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider    ExternalProvider
  stateHash   String           @unique
  redirectTo  String?
  locale      UserProfileLanguage @default(ZH_CN)
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([userId])
  @@index([provider])
  @@index([expiresAt])
}

model AuthRegistrationTicket {
  id                String                    @id @default(cuid())
  tokenHash         String                    @unique
  kind              AuthRegistrationTicketKind
  minecraftAccountId String?
  minecraftAccount  MinecraftAccount?         @relation(fields: [minecraftAccountId], references: [id], onDelete: Cascade)
  oauthProvider     ExternalProvider?
  payload           Json?
  expiresAt         DateTime
  consumedAt        DateTime?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  @@index([kind, expiresAt])
  @@index([consumedAt])
}

model SecurityEvent {
  id          String            @id @default(cuid())
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        SecurityEventType
  title       String
  description String?
  ipAddress   String?
  userAgent   String?
  metadata    Json?
  createdAt   DateTime          @default(now())

  @@index([userId, createdAt])
  @@index([type])
}
